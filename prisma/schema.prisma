generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

model Product {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  description      String
  price            Float
  comparePrice     Float?
  category         Category
  stock            Int              @default(0)
  images           String[]
  ingredients      String?
  fragrance        String?
  weightOz         Float?
  variantGroup     String?
  variantLabel     String?
  featured         Boolean          @default(false)
  active           Boolean          @default(true)
  moderationStatus ModerationStatus @default(APPROVED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  orderItems       OrderItem[]
  scentOptions     ProductScentOption[]

  @@schema("public")
}

model ProductScentOption {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String
  fragrance  String?
  stock      Int         @default(0)
  images     String[]
  sortOrder  Int         @default(0)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]

  @@index([productId])
  @@schema("public")
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)
  customer    Customer    @relation(fields: [customerId], references: [id])
  customerId  String
  items       OrderItem[]
  subtotal    Float
  shipping    Float       @default(0)
  tax         Float       @default(0)
  total       Float
  paymentId   String? @map("stripeId")
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@schema("public")
}

model OrderItem {
  id            String              @id @default(cuid())
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  product       Product             @relation(fields: [productId], references: [id])
  productId     String
  scentOption   ProductScentOption? @relation(fields: [scentOptionId], references: [id], onDelete: SetNull)
  scentOptionId String?
  scentLabel    String?
  quantity      Int
  price         Float

  @@schema("public")
}

model Customer {
  id           String         @id @default(cuid())
  email        String         @unique
  firstName    String
  lastName     String
  phone        String?
  status       CustomerStatus @default(ACTIVE)
  bannedAt     DateTime?
  bannedReason String?
  lastActiveAt DateTime?
  orders       Order[]
  subscriptions CustomerSubscription[]
  createdAt    DateTime       @default(now())

  @@schema("public")
}

model AdminUser {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  name        String
  role        Role      @default(ADMIN)
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())

  @@schema("public")
}

model StoreSettings {
  id                    String   @id @default("default")
  name                  String   @default("mvlusciouslather")
  tagline               String   @default("Where Ritual Meets Luxury")
  email                 String   @default("hello@mvlusciouslather.com")
  phone                 String?
  address               String?
  flatShippingRate      Float    @default(8)
  freeShippingThreshold Float    @default(75)
  notifyNewOrder        Boolean  @default(true)
  notifyOrderShipped    Boolean  @default(true)
  notifyLowStock        Boolean  @default(true)
  notifyNewCustomer     Boolean  @default(false)
  maintenanceMode       Boolean  @default(false)
  featureCheckout       Boolean  @default(true)
  featureNewsletter     Boolean  @default(true)
  bannedKeywords        String[] @default([])
  allowedEmailDomains   String[] @default([])
  updatedAt             DateTime @updatedAt

  @@schema("public")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@schema("public")
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  adminRole  String
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([entity])
  @@index([createdAt])
  @@schema("public")
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  segment   String    @default("all")
  sentCount Int       @default(0)
  sentAt    DateTime?
  createdBy String
  createdAt DateTime  @default(now())

  @@schema("public")
}

model AdminPushSubscription {
  id         String   @id @default(cuid())
  adminEmail String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([adminEmail])
  @@schema("public")
}

model StockNotifyRequest {
  id            String    @id @default(cuid())
  email         String
  productSlug   String
  productName   String
  scentOptionId String?
  scentLabel    String?
  notifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([productSlug, notifiedAt])
  @@index([email])
  @@schema("public")
}

model ProductReview {
  id          String           @id @default(cuid())
  productSlug String
  authorName  String
  title       String
  body        String
  rating      Int
  status      ModerationStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  @@index([productSlug, status])
  @@schema("public")
}

model PromoCode {
  id            String            @id @default(cuid())
  code          String            @unique
  discountType  PromoDiscountType
  discountValue Float
  minSubtotal   Float?
  active        Boolean           @default(true)
  expiresAt     DateTime?
  maxUses       Int?
  usedCount     Int               @default(0)
  createdAt     DateTime          @default(now())

  @@schema("public")
}

model CustomerSubscription {
  id                String               @id @default(cuid())
  customerId        String
  customer          Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status            CustomerSubStatus    @default(ACTIVE)
  cadence           SubscriptionCadence
  squareCustomerId  String
  squareCardId      String
  sourceOrderId     String?
  sourceOrderNumber String
  cartSnapshot      Json
  nextChargeAt      DateTime
  lastChargedAt     DateTime?
  pausedAt          DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([customerId, status])
  @@index([nextChargeAt, status])
  @@schema("public")
}

enum PromoDiscountType {
  PERCENT
  FIXED

  @@schema("public")
}

enum SubscriptionCadence {
  monthly
  bimonthly
  quarterly

  @@schema("public")
}

enum CustomerSubStatus {
  ACTIVE
  PAUSED
  CANCELLED

  @@schema("public")
}

enum Category {
  BAR_SOAP
  BATH_BODY
  CANDLES
  ACCESSORIES
  GIFT_SET

  @@schema("public")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED

  @@schema("public")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  EDITOR

  @@schema("public")
}

enum CustomerStatus {
  ACTIVE
  BANNED
  INACTIVE

  @@schema("public")
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED

  @@schema("public")
}
