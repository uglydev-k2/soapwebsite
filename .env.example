# =============================================================================
# REQUIRED for production (Vercel → Settings → Environment Variables)
# Missing any of these causes "Application error" on deploy.
# =============================================================================

# Supabase PostgreSQL (recommended)
# Vercel / app runtime — Transaction pooler (port 6543) from Supabase → Connect
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations & local db:push — Direct connection (port 5432) from Supabase → Connect
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="https://your-app.vercel.app"

# Supabase Auth (customer accounts)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google OAuth (optional — enable in Supabase dashboard too)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# OPTIONAL — features degrade gracefully without these
# =============================================================================

# Stripe (checkout + webhooks) — primary payment provider
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# U.S. storefront — Stripe USD checkout only (no alternate payment providers required)

# UploadThing (admin → Products → Upload Image)
# Create app at https://uploadthing.com/dashboard — use either pair below or TOKEN alone (v7+)
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="your-app-id"
# UPLOADTHING_TOKEN="sk_live_..."

# Resend (newsletter + order emails)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="hello@msvee.co"
