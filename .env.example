# =============================================================================
# REQUIRED for production (Vercel → Settings → Environment Variables)
# Missing any of these causes "Application error" on deploy.
# =============================================================================

# Supabase PostgreSQL (recommended)
# Vercel / app runtime — Transaction pooler (port 6543) from Supabase → Connect
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations & local db:push — Direct connection (port 5432) from Supabase → Connect
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="https://your-app.vercel.app"

# Storefront maintenance mode (set to "true" to block shopping with a full-screen message)
# Admin (/admin) stays accessible. Remove or set to "false" when you're ready to launch.
MAINTENANCE_MODE="false"
# MAINTENANCE_MESSAGE="We're refreshing our shop! Online orders return July 1."

# Supabase Auth (customer accounts)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google OAuth (optional — enable in Supabase dashboard too)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# OPTIONAL — features degrade gracefully without these
# =============================================================================

# Square (checkout — embedded card form on /checkout)
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
SQUARE_ENVIRONMENT="sandbox"
NEXT_PUBLIC_SQUARE_APPLICATION_ID=""
NEXT_PUBLIC_SQUARE_LOCATION_ID=""
# Optional webhook signature key for /api/square/webhook
# SQUARE_WEBHOOK_SIGNATURE_KEY=""

# Legacy Stripe (only needed if old checkout sessions are still in flight)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# UploadThing v7 (admin → Products → Upload Image)
# https://uploadthing.com/dashboard → your app → API Keys → V7 tab
UPLOADTHING_TOKEN="your-v7-token"

# Resend (newsletter + order emails)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="hello@msvee.co"
