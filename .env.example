# =============================================================================
# REQUIRED for production (Vercel → Settings → Environment Variables)
# Missing any of these causes "Application error" on deploy.
# =============================================================================

# PostgreSQL — use Vercel Postgres, Neon, or Supabase connection string
DATABASE_URL="postgresql://user:password@host:5432/msvee_soaps?schema=public"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="https://your-app.vercel.app"

# Supabase Auth (customer accounts)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google OAuth (optional — enable in Supabase dashboard too)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# OPTIONAL — features degrade gracefully without these
# =============================================================================

# Stripe (checkout + webhooks)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# UploadThing (product image uploads in admin)
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="your-app-id"

# Resend (newsletter + order emails)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="hello@msvee.co"
